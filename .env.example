# -----------------------------------------------------------------------------
# AQTP credentials — copy to .env (which is git-ignored). NEVER commit real keys.
# The application reads credentials ONLY from the environment / OS keychain.
# -----------------------------------------------------------------------------

# --- Groww Trading API ---
# Option A: long-lived daily access token (expires 06:00 IST daily)
GROWW_ACCESS_TOKEN=

# Option B: API key + secret (approval flow) — token minted at startup
GROWW_API_KEY=
GROWW_API_SECRET=

# Option C: API key + TOTP flow
GROWW_TOTP_SECRET=

# Which auth flow to use: token | approval | totp
GROWW_AUTH_MODE=token

# --- Safety interlocks for LIVE mode (all three required, see config schema) ---
# LIVE trading is refused unless every one of these is set exactly as shown.
AQTP_LIVE_CONFIRM_1=
AQTP_LIVE_CONFIRM_2=
AQTP_LIVE_CONFIRM_3=

# --- Optional alerting sinks ---
AQTP_ALERT_WEBHOOK_URL=
