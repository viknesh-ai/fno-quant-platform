# -----------------------------------------------------------------------------
# AQTP credentials — copy to .env (which is git-ignored). NEVER commit real keys.
# The application reads credentials ONLY from the environment / OS keychain, and
# a redaction filter scrubs them from every log record.
#
#   cp .env.example .env && $EDITOR .env && chmod 600 .env
# -----------------------------------------------------------------------------

# --- Groww Trading API ---
# Option A: long-lived daily access token (expires 06:00 IST daily)
GROWW_ACCESS_TOKEN=

# Option B: API key + secret (approval flow) — token minted at startup
GROWW_API_KEY=
GROWW_API_SECRET=

# Option C: API key + TOTP flow
GROWW_TOTP_SECRET=

# Which auth flow to use: token | approval | totp
GROWW_AUTH_MODE=token

# -----------------------------------------------------------------------------
# LIVE trading interlocks
#
# config/default.yaml ships with `mode: LIVE`, but the process still refuses to
# start unless all three of these are present with exactly these values. That is
# deliberate: the mode says what this platform is for, the interlocks say that a
# human decided to run it today. `aqtp arm` prints them.
#
# These are left BLANK on purpose. Copying this file must never arm live
# trading by itself — filling them in has to be a thing you did, not a thing a
# `cp` did. The exact values each one expects are shown beside it, and
# `aqtp arm` prints them too.
#
# Leave them blank for a dry run: set `mode: PAPER` in the config, or run
# `aqtp start --mode PAPER` for real market data with simulated fills.
# -----------------------------------------------------------------------------
# expects exactly: I_UNDERSTAND_REAL_MONEY
AQTP_LIVE_CONFIRM_1=
# expects exactly: I_HAVE_REVIEWED_RISK_LIMITS
AQTP_LIVE_CONFIRM_2=
# expects exactly: ENABLE_LIVE_TRADING
AQTP_LIVE_CONFIRM_3=

# --- Optional alerting sinks ---
AQTP_ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Any config field can be overridden here with AQTP_<SECTION>__<FIELD>.
# Double underscore separates nesting levels. A few useful ones:
# -----------------------------------------------------------------------------
# AQTP_CAPITAL__AVAILABLE_CAPITAL=500000
# AQTP_RISK__RISK_PER_TRADE_PCT=0.01
# AQTP_RISK__MAX_OPEN_POSITIONS=4
# AQTP_ANALYSIS__MIN_CONVICTION=0.20
# AQTP_ANALYSIS__INFLUENCE=0.50
# AQTP_RUNTIME__SQUARE_OFF_ON_SHUTDOWN=false
# AQTP_MONITORING__DASHBOARD_HOST=127.0.0.1
